{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/router.ts": { "includeFiles": "server/generated/**", "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/commit", "schedule": "17 22 * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?__route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
