# ── Game server (Vercel → Project → Settings → Environment Variables) ──
# Long random string. Picks the daily puzzles and encrypts game sessions. Keep it secret, never change it after launch.
TICKR_SECRET=
# Private key of the game-server wallet. It signs solves and relays them (pays gas) — fund it with testnet ETH.
TICKR_SIGNER_KEY=
# Deployed TickrGame address on Robinhood Chain testnet.
TICKR_CONTRACT=
# robinhood-testnet (default) or local
TICKR_NETWORK=robinhood-testnet
# Optional: a dedicated RPC (e.g. Alchemy) instead of the rate-limited public one.
TICKR_RPC_URL=
# Day that is puzzle #001 (UTC).
TICKR_LAUNCH_DATE=2026-11-10
# Vercel Cron auth for /api/cron/commit (any random string).
CRON_SECRET=

# ── Frontend ──
# Privy app id for email sign-in (https://dashboard.privy.io). Without it the app falls back to a guest wallet.
VITE_PRIVY_APP_ID=
