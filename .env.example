# ── Game server (Vercel → Project → Settings → Environment Variables) ──
# Long random string. Picks the daily puzzles and encrypts game sessions. Keep it secret, never change it after launch.
TICKR_SECRET=
# Private key of the game-server wallet. It signs solves and relays them (pays gas) — fund it with testnet ETH.
TICKR_SIGNER_KEY=
# Deployed TickrGame address on Robinhood Chain testnet.
TICKR_CONTRACT=
# robinhood-testnet (default) or local
TICKR_NETWORK=robinhood-testnet
# Optional: a dedicated RPC (e.g. Alchemy) instead of the rate-limited public one.
TICKR_RPC_URL=
# Preview season start (Preview #1) and Season 0 launch (puzzle #001), UTC.
TICKR_PREVIEW_DATE=2026-11-10
TICKR_LAUNCH_DATE=2026-12-20
# Vercel Cron auth for /api/cron/commit (any random string).
CRON_SECRET=

# ── Frontend ──
# Reown (WalletConnect) project id (https://dashboard.reown.com). Enables Robinhood Wallet and other mobile wallets
# via QR code. Without it, only browser-extension wallets (MetaMask, Rabby…) can connect.
VITE_WALLETCONNECT_PROJECT_ID=

# Offline dev only: simulated live prices + candles.
TICKR_MOCK_MARKET=

# Live presence (online / watching counts) — Vercel Storage → Upstash for Redis sets these.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── $WIF loop (Robinhood Chain mainnet) ──
# Private key of the mainnet wallet that owns TickrWifPot, signs rewards and relays them (holds real ETH for gas).
WIF_SIGNER_KEY=
# Deployed TickrWifPot address on Robinhood Chain mainnet (chain 4663).
WIF_CONTRACT=
# Optional: a dedicated mainnet RPC instead of https://rpc.mainnet.chain.robinhood.com
WIF_RPC_URL=
